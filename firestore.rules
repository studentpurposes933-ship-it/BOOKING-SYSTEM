rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profile collection rules
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Appointments collection rules
    match /appointments/{appointmentId} {
      // Authenticated users can read all appointments to calculate calendar availability
      allow read: if request.auth != null;

      // Authenticated users can create valid appointments owned by their uid
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;

      // Users can update or cancel only their own appointments
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Blocked slots collection rules
    match /blockedSlots/{blockedSlotId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }
  }
}
